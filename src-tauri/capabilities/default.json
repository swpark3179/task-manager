{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and dashboard windows",
  "windows": [
    "main",
    "dashboard",
    "activity-report",
    "detail-*",
    "calendar-popup"
  ],
  "permissions": [
    "core:default",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:window:default",
    "opener:default",
    "store:default",
    "fs:default",
    "dialog:default",
    "notification:default"
  ]
}
