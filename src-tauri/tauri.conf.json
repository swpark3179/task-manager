{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Manager",
  "version": "1.13.6",
  "identifier": "com.swpark3179.task-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Task Manager - 업무 관리",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600
      },
      {
        "label": "dashboard",
        "title": "Task Manager Dashboard",
        "url": "index.html#/dashboard",
        "visible": false,
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 320,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
